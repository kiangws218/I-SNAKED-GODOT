{
  "intro": {"speaker":"旁白","pages":["走过断桥，一辆马车停在烂泥里。","这个国家打输了。王国占了这里，收钱的人比种地的人还多。","车里蜷着一个昏迷的女孩。是可蒂。"],"choices":[{"id":"continue","label":"去看看","action":"intro"}]},
  "merchant": {"speaker":"商人","pages":["她？路边捡的。饿昏了，没死。","送去城里卖，多少能换点钱。","别瞪我。王国天天收钱，总得有人付账。"],"choices":[{"id":"deal","label":"交涉：人归我，你继续赶路","action":"negotiate"},{"id":"threat","label":"威胁：开门，还是进我肚子？","action":"threat"},{"id":"eat","label":"吃掉商人","action":"eat"},{"id":"attack","label":"攻击商人（击晕）","action":"attack"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "deal_reply": {"speaker":"商人","pages":["你这条蛇，哪儿是讲价，简直是会动的欠条。","行，人给你。我留她鞋子就行——城里有人买这玩意，比人还贵。","外锁开了。里面还卡着，拉车侧的杆子。"],"choices":[{"id":"leave","label":"去拉开门杆","action":"leave"}]},
  "threat_reply": {"speaker":"商人","pages":["开！马上开！我还有上个月没交的钱！","外锁开了。车侧有根杆子，你自己拉。"],"choices":[{"id":"leave","label":"去拉开门杆","action":"leave"}]},
  "key": {"speaker":"旁白","pages":["工具箱没锁，备用钥匙就挂在钉子上。","一整车人锁得死死的，钥匙倒是谁都能拿。"],"choices":[{"id":"key","label":"拿钥匙，打开外锁","action":"key"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "lever": {"speaker":"旁白","pages":["车侧的杆子连着里面的卡扣。","先开外锁，再拉杆子，一个人就能打开。"],"choices":[{"id":"lever","label":"拉开门杆","action":"lever"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "cart": {"speaker":"旁白","pages":["可蒂在车里昏睡，怎么叫都没有回答。","先找商人开锁，或拿工具箱的钥匙。再拉车侧的杆子。"],"choices":[{"id":"leave","label":"寻找开门办法","action":"leave"}]},
  "locked": {"speaker":"旁白","pages":["隔着车板碰不到她。先把车厢打开。"],"choices":[{"id":"leave","label":"去开门","action":"leave"}]},
  "cart_open": {"speaker":"旁白","pages":["车门开着。可以靠近可蒂，把她带出来。"],"choices":[{"id":"leave","label":"去找可蒂","action":"leave"}]},
  "keti_down": {"speaker":"旁白","pages":["可蒂没有醒。呼吸很轻，眉头还皱着。"],"choices":[{"id":"stretcher","label":"放到蛇背的担架上","action":"stretcher"},{"id":"protect","label":"吞下保护，带离这里","action":"protect"},{"id":"face","label":"舔脸叫醒","action":"face"},{"id":"foot","label":"舔脚叫醒","action":"foot","presentation":{"cg_id":"lick","variant":"keti_foot","portrait_id":"keti","portrait_expression":"shy"}},{"id":"eat","label":"吃掉可蒂（普通吞人）","action":"eat"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "keti_face_reply": {"speaker":"可蒂","portrait":"keti","expression":"shy","pages":["呜……凉的！你洗过脸吗就往我脸上蹭！","……是你啊。","我才没等你。只是……刚好有点走不动。"],"choices":[{"id":"leave","label":"让她缓缓","action":"leave"}]},
  "keti_foot_reply": {"speaker":"可蒂","portrait":"keti","expression":"shy","pages":["呀！谁让你碰那里了！","我醒了！真的醒了！不用再确认一遍！","……你还知道回来。笨蛇。"],"choices":[{"id":"leave","label":"让她缓缓","action":"leave"}]},
  "keti_awake": {"speaker":"可蒂","portrait":"keti","pages":["别看，我只是站起来会有一点点晕。","一点点！不是要你一直扶着！"],"choices":[{"id":"stretcher","label":"带她到渡口休息","action":"stretcher"},{"id":"eat","label":"吃掉可蒂","action":"eat"},{"id":"attack","label":"攻击可蒂（击晕）","action":"attack"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "cot": {"speaker":"旁白","pages":["渡口有块铺着旧毯子的木台。","把可蒂放下来，她才好休息。船夫不在也能用。"],"choices":[{"id":"settle","label":"安置带来的可蒂","action":"settle"},{"id":"dismount","label":"让蛇背上的乘客先下来","action":"dismount"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "keti_cot": {"speaker":"可蒂","portrait":"keti","expression":"shy","pages":["村里人说我不能离开那片荒野……","算了，我不想回去了。你也没地方去吧？","我可以勉为其难陪你走一段。不是怕你走丢！"],"choices":[{"id":"duo","label":"那就一起走吧","action":"duo"},{"id":"ride","label":"可蒂，上蛇同行","action":"ride"},{"id":"dismount","label":"让可蒂下蛇","action":"dismount"},{"id":"eat","label":"吃掉可蒂","action":"eat"},{"id":"attack","label":"攻击可蒂（击晕）","action":"attack"},{"id":"leave","label":"再准备一下","action":"leave"}]},
  "ending": {"speaker":"可蒂","portrait":"keti","expression":"smile","pages":["走慢一点啊。我……我只是还没吃饭。","下次找到吃的，你先给我看一眼。","谁让你连商人都想尝一口！"],"choices":[{"id":"leave","label":"结伴出发 · 灰盒试玩完成","action":"leave"}]},
  "ending_occupied": {"speaker":"可蒂","portrait":"keti","expression":"shy","pages":["你背上已经有人了！先让他下来，再来接我……我才不是在抢座。"],"choices":[{"id":"leave","label":"结伴出发 · 灰盒试玩完成","action":"leave"}]},
  "npc_down": {"speaker":"旁白","pages":["人只是昏过去了。","可以舔脸或舔脚叫醒；之前的事，他不会忘。"],"choices":[{"id":"face","label":"舔脸叫醒","action":"face"},{"id":"foot","label":"舔脚叫醒","action":"foot"},{"id":"eat","label":"吃掉","action":"eat"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "wake_reply": {"speaker":"旁白","pages":["他猛地醒来，抹了把脸，又低头检查鞋子。","人醒了，不代表刚才的事就当没发生。"],"choices":[{"id":"leave","label":"暂时离开","action":"leave"}]},
  "ferryman": {"speaker":"船夫","pages":["王国要过河的钱，商人要卖人的钱。","我就想收个撑船的钱。这河都快被他们收干了。","木台借你休息，不要钱。"],"choices":[{"id":"eat","label":"吃掉船夫","action":"eat"},{"id":"attack","label":"攻击船夫（击晕）","action":"attack"},{"id":"threat","label":"威胁船夫","action":"threat"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "buck": {"speaker":"巴克","pages":["又是你。我沿着路找吃的，碰上这车。","抢我？我比这马车还穷。"],"choices":[{"id":"eat","label":"吃掉巴克","action":"eat"},{"id":"attack","label":"攻击巴克（击晕）","action":"attack"},{"id":"threat","label":"威胁巴克","action":"threat"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "miro": {"speaker":"米罗","pages":["本来想跟着商队混口饭吃。","目前只吃到了一嘴灰。你那边有没沾口水的吃的吗？"],"choices":[{"id":"eat","label":"吃掉米罗","action":"eat"},{"id":"attack","label":"攻击米罗（击晕）","action":"attack"},{"id":"threat","label":"威胁米罗","action":"threat"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "npc_threat_reply": {"speaker":"旁白","pages":["他盯着你的嘴，默默退开一步。","以后有人找你帮忙，也有人只想躲远点。"],"choices":[{"id":"leave","label":"暂时离开","action":"leave"}]},
  "npc": {"speaker":"旁白","pages":["他还记得之前发生的事。"],"choices":[{"id":"eat","label":"吃掉","action":"eat"},{"id":"attack","label":"攻击（击晕）","action":"attack"},{"id":"threat","label":"威胁","action":"threat"},{"id":"leave","label":"暂时离开","action":"leave"}]},
  "merchant_repeat": {"speaker":"商人","pages":["还想带她走？那就谈谈。别在车边绕得我头晕。"],"choices_from":"merchant"},
  "merchant_open": {"speaker":"商人","pages":["外锁已经开了，还看着我干什么？","车侧的杆子，你自己拉。别把整辆车吞了。"],"choices_from":"merchant"},
  "merchant_threatened": {"speaker":"商人","pages":["锁开了！真的开了！别再冲我张嘴。","里面的卡扣归那根杆子管，不归我管！"],"choices_from":"merchant"},
  "merchant_hurt": {"speaker":"商人","pages":["把我折腾成这样，又把我弄醒……你到底想干什么？","要人就带走。别再拿我试了。"],"choices_from":"merchant"},
  "merchant_cart_open": {"speaker":"商人","pages":["门已经敞着了。人就在里面，你自己带走。","我可没拦你，别再拿我磨牙！"],"choices_from":"merchant"},
  "merchant_rescued": {"speaker":"商人","pages":["她都被你带走了，还回来做什么？","你赶紧陪她走吧。这笔生意我认栽。"],"choices_from":"merchant"},
  "keti_awake_repeat": {"speaker":"可蒂","portrait":"keti","pages":["我能听见，不用又凑那么近！","……前面有地方休息吗？扶一下就好。"],"choices_from":"keti_awake"},
  "keti_cot_repeat": {"speaker":"可蒂","portrait":"keti","expression":"shy","pages":["想好了没有？刚才说的……一起走。","不答应也行。你别真的走啊！"],"choices_from":"keti_cot"},
  "keti_cot_hurt": {"speaker":"可蒂","portrait":"keti","expression":"angry","pages":["又欺负我，又来照顾我，你这条笨蛇！","我还是想离开这里。一起走可以，不许再拿我试嘴。"],"choices_from":"keti_cot"},
  "keti_duo": {"speaker":"可蒂","portrait":"keti","expression":"smile","pages":["不是说好一起走了吗？我又不会跑。","……你靠近一点也行。我只是怕你听不见。"],"choices_from":"keti_cot"},
  "keti_duo_hurt": {"speaker":"可蒂","portrait":"keti","expression":"angry","pages":["才说好一起走，你就欺负同伴！","说好的事算数。但你再这样，我就咬回去！"],"choices_from":"keti_cot"},
  "keti_rewake_reply": {"speaker":"可蒂","portrait":"keti","expression":"angry","pages":["我认得你！不用每回醒来都这样确认！","笨蛇，下次用正常一点的办法叫我！"],"choices":[{"id":"leave","label":"让她缓缓","action":"leave"}]},
  "ferryman_repeat": {"speaker":"船夫","pages":["木台还是借你用。人歇好了就行。","撑船的事等我回来再说，别把船当碗。"],"choices_from":"ferryman"},
  "buck_repeat": {"speaker":"巴克","pages":["我还在找吃的。放心，这回没拦你的路。"],"choices_from":"buck"},
  "miro_repeat": {"speaker":"米罗","pages":["饭还没混上。找到能吃的，记得叫我一声。"],"choices_from":"miro"},
  "npc_threatened": {"speaker":"旁白","pages":["他认出了刚才威胁他的那张嘴，往后挪了挪。","有话还能说，但他已经不敢像刚才那样轻松了。"],"choices_from":"npc"},
  "npc_hurt": {"speaker":"旁白","pages":["他还记得被你弄昏或吞下的事，护着脑袋和鞋子。","人醒了，也没把你当成没事发生的熟人。"],"choices_from":"npc"},
  "npc_threat_again": {"speaker":"旁白","pages":["他立刻缩了缩脖子。你刚才的威胁，他还记得。"],"choices":[{"id":"leave","label":"暂时离开","action":"leave"}]},
  "key_open": {"speaker":"旁白","pages":["外锁已经开了，不用再找钥匙。"],"choices":[{"id":"leave","label":"离开工具箱","action":"leave"}]},
  "lever_open": {"speaker":"旁白","pages":["卡扣已经拉开，车门敞着。杆子不用再拉。"],"choices":[{"id":"leave","label":"离开开门杆","action":"leave"}]},
  "cart_unlocked": {"speaker":"旁白","pages":["外锁已经松开，里面还卡着。","拉车侧的杆子，就能打开车门。"],"choices":[{"id":"leave","label":"去拉开门杆","action":"leave"}]},
  "cart_empty": {"speaker":"旁白","pages":["可蒂已经离开车厢。旧毯子上只剩下她躺过的痕迹。"],"choices":[{"id":"leave","label":"离开马车","action":"leave"}]},
  "cot_done": {"speaker":"旁白","pages":["这里是你们刚才休息的地方。可蒂已经答应同行。"],"choices_from":"cot"}
